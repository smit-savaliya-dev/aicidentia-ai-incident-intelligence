# Copy to .env and adjust. Loaded by aicidentia.config at import time (existing environment variables win).

# Where Hugging Face models are cached (default: ~/.cache/huggingface).
# HF_HOME=D:/caches/huggingface

# Where uv caches packages. uv does not read .env: put the same path in uv.toml as cache-dir
# (Windows: %APPDATA%\uv\uv.toml; Linux/macOS: ~/.config/uv/uv.toml) or set it as an environment variable.
# UV_CACHE_DIR=D:/caches/uv

# Forbid model downloads (models must already be cached).
# HF_HUB_OFFLINE=1

# Where Playwright keeps its browser and ffmpeg (screenshots and the backup demo video).
# PLAYWRIGHT_BROWSERS_PATH=D:/caches/ms-playwright
